# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Phase 3) ---
# Supabase dashboard > Project Settings > API (or Connect).
# The URL looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public key: either the "anon" key or the newer "publishable" key
# (starts with sb_publishable_). Both work here. Never put the service_role or
# secret key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Speech generation ---
# Which writer to use. Generation stays switched off while this is empty.
#   mock    placeholder text, no AI calls, no key needed (for development)
#   gemini  real speeches from Google Gemini
AI_PROVIDER=
# From Google AI Studio > Get API key. Server-only: never prefix it NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite. If you pick a model that
# src/lib/ai/models.ts does not list, add a rule there for its thinking setting.
GEMINI_MODEL=
# Optional, mock only: milliseconds between streamed chunks (default 15).
MOCK_AI_DELAY_MS=
